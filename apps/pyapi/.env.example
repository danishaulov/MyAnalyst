# Configure on the Python Vercel project (apps/pyapi), independently of apps/web.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Exact browser origins. Add the actual Vercel preview origin when testing a preview.
# This is a CORS policy, not authentication or protection against direct HTTP clients.
API_ALLOWED_ORIGINS=https://myanalyst.net,https://www.myanalyst.net,http://localhost:3000,http://127.0.0.1:3000
